# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=1
ALLOWED_HOSTS=*

# Database (PostgreSQL is required for production/assessment)
# Set DB_ENGINE=django.db.backends.postgresql to use Postgres.
# Leave unset to fall back to SQLite for local development/tests.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=capitalrecon
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Airtable (optional bonus - leave empty to disable)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
